<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ için yedekleme / cihaz aktarım kuralları.
   app_settings.xml API anahtarlarını içerir; buluta veya başka cihaza aktarılmaz.
   opus_en_tr/ 355 MB'lık OPUS modeli: yedek kotasını aşar, uygulamadan tekrar indirilebilir.
   gemma_fixer/ ~2,6 GB'lık isteğe bağlı Gemma modeli: aynı sebeple yedeklenmez.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_settings.xml" />
        <exclude domain="file" path="opus_en_tr/" />
        <exclude domain="file" path="gemma_fixer/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_settings.xml" />
        <exclude domain="file" path="opus_en_tr/" />
        <exclude domain="file" path="gemma_fixer/" />
    </device-transfer>
</data-extraction-rules>
