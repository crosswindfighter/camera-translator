<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ için yedekleme / cihaz aktarım kuralları.
   app_settings.xml API anahtarlarını içerir; buluta veya başka cihaza aktarılmaz.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_settings.xml" />
    </device-transfer>
</data-extraction-rules>
