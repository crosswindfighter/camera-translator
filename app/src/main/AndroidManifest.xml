<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Offline+ model indirmeden önce mobil veri uyarısı için -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Uygulama içi güncelleme: indirilen yeni sürüm APK'sının kurulum penceresini açmak için -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Telefon ekranı modu: ekranı yakalayan ön plan hizmeti ve oyunun üstünde görünen çeviri katmanı -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" />
    <uses-feature android:name="android.hardware.camera.autofocus" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <package android:name="com.samsung.SMT" />
        <package android:name="com.samsung.android.tts" />
        <package android:name="com.samsung.SMT.lang_tr_TR" />
        <package android:name="com.google.android.tts" />
    </queries>

    <application
        android:allowBackup="true"
        android:resizeableActivity="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CameraTranslator">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CameraTranslator"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboard|keyboardHidden|navigation"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Samsung DeX / serbest pencere: ilk açılışta makul bir pencere boyutu -->
            <layout
                android:defaultWidth="960dp"
                android:defaultHeight="600dp"
                android:gravity="center" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Samsung DeX: DeX'e girip çıkarken (ekran yoğunluğu değişince) uygulama yeniden başlatılmasın -->
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />

        <!-- Telefon ekranı modu: ekranı okuyup oyunun üstünde çeviri gösteren hizmet -->
        <service
            android:name=".PhoneScreenService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Uygulama içi güncelleme: indirilen APK kurulum penceresine buradan verilir -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>